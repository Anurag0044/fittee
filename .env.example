# ==============================================================================
# FITTEE BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development. Never commit real secrets to Git.
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=8000
API_PREFIX=/api/v1

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://fittee.in,https://admin.fittee.in

# Database Connection (Neon Serverless PostgreSQL)
# DATABASE_URL: PgBouncer pooled connection (-pooler suffix)
DATABASE_URL="postgresql://neondb_owner:mock_password@ep-cold-cloud-123456-pooler.ap-south-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: Direct unpooled connection for migrations
DIRECT_URL="postgresql://neondb_owner:mock_password@ep-cold-cloud-123456.ap-south-1.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication
JWT_SECRET=fittee_dev_jwt_secret_key_at_least_32_characters_long_12345
JWT_EXPIRES_IN=7d

# Third-Party Service Simulations (Set to true to use built-in mock handlers)
MOCK_EXTERNAL_SERVICES=true

# Razorpay Payments (Test credentials or mock mode)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Ekart Logistics (API v2 credentials or mock mode)
EKART_MERCHANT_CODE=FITTEE_MOCK_MERCHANT
EKART_ACCESS_TOKEN=ekart_mock_token_placeholder
EKART_BASE_URL=https://api.ekartlogistics.com
EKART_HMAC_SECRET=ekart_mock_hmac_placeholder

# Cloudinary CDN (Image uploads or mock signatures)
CLOUDINARY_CLOUD_NAME=fittee-mock
CLOUDINARY_API_KEY=mock_cloudinary_key
CLOUDINARY_API_SECRET=mock_cloudinary_secret
